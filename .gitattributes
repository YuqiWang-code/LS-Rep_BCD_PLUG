# 换行符规范：仓库内统一 LF；代码/脚本/文档在检出时强制 LF。
# .sh/.py 若被 Windows 检出成 CRLF，会在服务器上运行报错（见 docs/SERVER_AND_DATASETS.md）。
* text=auto

*.sh    text eol=lf
*.py    text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.json  text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.toml  text eol=lf
*.cfg   text eol=lf

# 二进制文件不做换行符转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.pt    binary
*.pth   binary
*.xlsx  binary
*.pdf   binary
